rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users Collection ───
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Only the user can create/update their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);

      // Only the user can delete their own profile
      allow delete: if isOwner(userId);

      // Subcollections
      match /verificationData/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /profileImages/{docId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // ─── User Preferences Collection ───
    match /user_preferences/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // ─── Rides Collection ───
    match /rides/{rideId} {
      // Anyone authenticated can read rides
      allow read: if isAuthenticated();

      // Anyone authenticated can create a ride
      allow create: if isAuthenticated();

      // Only the driver can update/delete their ride
      allow update: if isAuthenticated() &&
        (resource.data.driver.id == request.auth.uid ||
         request.auth.uid in resource.data.passengerIds);
      allow delete: if isAuthenticated() &&
        resource.data.driver.id == request.auth.uid;
    }

    // ─── Bookings Collection ───
    match /bookings/{bookingId} {
      // Passenger or ride driver can read
      allow read: if isAuthenticated() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);

      // Anyone authenticated can create a booking
      allow create: if isAuthenticated();

      // Passenger or driver can update (confirm/cancel)
      allow update: if isAuthenticated() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);

      // Only passenger can delete their booking
      allow delete: if isAuthenticated() &&
        resource.data.passengerId == request.auth.uid;
    }

    // ─── Messages Collection ───
    match /messages/{messageId} {
      // Only sender or receiver can read
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);

      // Anyone authenticated can send messages
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid;

      // Only sender can update/delete
      allow update, delete: if isAuthenticated() &&
        resource.data.senderId == request.auth.uid;
    }

    // ─── Conversations Collection ───
    match /conversations/{conversationId} {
      // Participants can read
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;

      // Anyone authenticated can create (starting a conversation)
      allow create: if isAuthenticated();

      // Participants can update
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;

      allow delete: if false; // Don't allow direct deletion
    }

    // ─── Notifications Collection ───
    match /notifications/{notificationId} {
      // Only the target user can read their notifications
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // System (or authenticated user) can create notifications
      allow create: if isAuthenticated();

      // Only the target user can update (mark as read)
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;

      // Only the target user can delete
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
    }

    // ─── Ratings Collection ───
    match /ratings/{ratingId} {
      // Anyone authenticated can read ratings
      allow read: if isAuthenticated();

      // Only authenticated users can create (and must be the rater)
      allow create: if isAuthenticated() &&
        request.resource.data.raterUserId == request.auth.uid;

      // Ratings cannot be updated or deleted by users
      allow update, delete: if false;
    }

    // ─── Payments Collection ───
    match /payments/{paymentId} {
      // Payer or receiver can read
      allow read: if isAuthenticated() &&
        (resource.data.payerId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);

      // Anyone authenticated can create
      allow create: if isAuthenticated();

      // Only payer can update
      allow update: if isAuthenticated() &&
        resource.data.payerId == request.auth.uid;

      allow delete: if false;
    }

    // ─── Calls Collection ───
    match /calls/{callId} {
      // Caller or receiver can read
      allow read: if isAuthenticated() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);

      // Anyone authenticated can initiate a call
      allow create: if isAuthenticated();

      // Caller or receiver can update (answer, end)
      allow update: if isAuthenticated() &&
        (resource.data.callerId == request.auth.uid ||
         resource.data.receiverId == request.auth.uid);

      allow delete: if false;
    }

    // ─── Ride History (analytics) ───
    match /ride_history/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── Match History (analytics) ───
    match /match_history/{docId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── Payment Methods (subcollection of users) ───
    match /payment_methods/{userId}/methods/{methodId} {
      allow read, write: if isOwner(userId);
    }
  }
}
